# Base URL the frontend calls at runtime (Vite injects this at build time).
# Must be the deployed API Gateway URL of the Prod stage, WITHOUT the
# /api/analyze suffix — the frontend appends the path itself:
#   https://<api-id>.execute-api.<region>.amazonaws.com/Prod
# (Get the exact value from the stack's ApiUrl output.)
# For a manual production build:  VITE_API_BASE_URL=https://... npm run build
# In CI, this is supplied by the API_URL repository secret instead.
VITE_API_BASE_URL=https://YOUR_API_URL.example.com