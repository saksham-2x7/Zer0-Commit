# Base URL of the backend API (SUTRADHAR's backend — see backend/api/CONTRACT.md).
#
# Local dev against the bundled dev API server (`npm run dev:api` at the repo
# root): keep the value below so /api/* calls hit http://localhost:3000.
VITE_API_BASE_URL=http://localhost:3000
#
# Deployed: set this to your API Gateway base URL before building, or leave it
# empty ("") to use same-origin /api/* paths — that works when the frontend
# and API are served from the same origin (a Vite dev-server proxy, or a
# CloudFront distribution in front of both the S3 site and the API).
