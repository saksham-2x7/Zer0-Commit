# ScamSahayak backend environment — reference values, kept in sync with
# infra/template.yaml Parameters and backend/api/CONTRACT.md.
#
# Local dev: read by backend/api/devServer.js and the Lambda handlers when
# run directly; unset values fall back to the defaults below.
#
# Deployed (Ship It): the same values are supplied by the SAM stack via
# `sam deploy --guided` parameters — this file is NOT picked up on deploy.

# Bedrock model used by the explanation module (VAANI).
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
# "true" skips real Bedrock calls (offline demo/dev only). Leave "false" on deploy.
MOCK_BEDROCK=false
# CORS origin allowed to call the API. REPLACE with the real frontend URL —
# never "*" in production.
ALLOWED_ORIGIN=https://YOUR_DOMAIN.example.com
# Max raw image size in bytes. 4 MiB keeps the base64 payload (~5.33 MiB)
# under the ~6 MiB Lambda synchronous-invoke limit.
MAX_INPUT_BYTES=4194304
# AWS region for Textract/Bedrock/DynamoDB/S3 clients.
AWS_REGION=ap-south-1

# DynamoDB table for redacted case records (unset = in-memory local mode).
# CASES_TABLE_NAME=scamsahayak-cases
# S3 bucket for redacted evidence bundles (unset = client-side download mode).
# EVIDENCE_BUCKET_NAME=scamsahayak-evidence